Public Class Module_Main\n    'Main entry point for ComServ Africa POS System\n    \n    <STAThread()>\n    Sub Main()\n        Application.EnableVisualStyles()\n        Application.SetCompatibleTextRenderingDefault(False)\n        \n        'Display splash screen and initialize application\n        Try\n            'Load global settings\n            InitializeApplication()\n            \n            'Show login form\n            Application.Run(New LoginForm())\n        Catch ex As Exception\n            MessageBox.Show(\"Fatal Error: \" & ex.Message, \"Startup Error\", MessageBoxButtons.OK, MessageBoxIcon.Error)\n            Application.Exit()\n        End Try\n    End Sub\n    \n    Private Sub InitializeApplication()\n        'Initialize application settings and database connection\n        Try\n            'Verify database exists\n            Dim dbPath As String = Application.StartupPath & \"\\ComServPOS.accdb\"\n            If Not System.IO.File.Exists(dbPath) Then\n                Throw New Exception(\"Database file not found: \" & dbPath)\n            End If\n            \n            'Set connection string\n            GlobalVariables.DBConnectionString = \"Provider=Microsoft.ACE.OLEDB.12.0;Data Source=\" & dbPath\n            \n        Catch ex As Exception\n            Throw New Exception(\"Failed to initialize application: \" & ex.Message)\n        End Try\n    End Sub\nEnd Module\n